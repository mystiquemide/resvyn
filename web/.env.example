# Resvyn web app environment (server-only unless prefixed NEXT_PUBLIC_).
# Copy to .env.local. Never commit real keys.

# Public origin used for social metadata (og:image, link previews). Must be the
# real deployed domain, e.g. https://resvyn.app once hosting is live.
NEXT_PUBLIC_SITE_URL=

# The deployed WarrantyReserve on BOT Chain Mainnet (chain 677).
# CP-011 instance: 0x414592d2313d233b673b1f97803c261355ccd996
NEXT_PUBLIC_RESVYN_ADDRESS=0x414592d2313d233b673b1f97803c261355ccd996

# Dedicated evaluator signing key (32-byte hex). Without it /api/evaluate
# returns 503 evaluator_not_configured and never signs.
RESVYN_EVALUATOR_KEY=

# Groq evaluator brain. When RESVYN_GROQ_KEY is set, Groq proposes decisions
# behind the hard-signal policy gate and the schema gate; the key never leaves
# the server and is never in source. When unset, the deterministic policy is
# the brain and the route behaves exactly as before.
RESVYN_GROQ_KEY=
# Optional: model override (default openai/gpt-oss-120b, Groq's recommended
# replacement for the retired llama-3.3-70b-versatile) and timeout.
RESVYN_GROQ_MODEL=openai/gpt-oss-120b
RESVYN_GROQ_TIMEOUT_MS=30000

# Rate limiting for /api/evaluate (in-memory, single instance).
RESVYN_RATE_LIMIT_MAX=10
RESVYN_RATE_LIMIT_WINDOW_MS=60000

# Scripts-only (rehearse/paymaster), not read by the web app:
# RESVYN_DEPLOYER_KEY, RESVYN_CLAIMANT_KEY, RESVYN_PAYMASTER_URL
