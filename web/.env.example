# Resvyn web app environment.
# Copy to .env.local. Never commit real keys.

# Public origin used for social metadata and link previews.
NEXT_PUBLIC_SITE_URL=https://resvyn.vercel.app

# Cross-origin evaluator/evidence API (e.g. a VPS-hosted backend). Unset =
# same-origin calls, which is the local development/test default.
NEXT_PUBLIC_RESVYN_API_BASE=

# Current hardened WarrantyReserve on BOT Chain Mainnet (chain 677).
# Source verified on BOTScan.
NEXT_PUBLIC_RESVYN_ADDRESS=0x96829b22ae7e59ac0f7d2ca6c50d017b51954ffe
NEXT_PUBLIC_DEPLOY_START_BLOCK=19898630

# Safe default: keep writes OFF in a fresh clone.
# To enable writes, BOTH of the following must be set deliberately and the live
# contract signer must match the pinned evaluator. The evaluator server also
# verifies its private key against the same on-chain signer before signing.
NEXT_PUBLIC_RESVYN_EXPECTED_EVALUATOR=
NEXT_PUBLIC_RESVYN_OPERATIONAL=0

# Server-only evaluator signing key (32-byte hex). Never expose this through a
# NEXT_PUBLIC_* variable. Without it /api/evaluate returns 503 and signs nothing.
RESVYN_EVALUATOR_KEY=

# Durable evidence persistence. Operational write mode requires a durable,
# writable path. An ephemeral serverless filesystem is not sufficient.
RESVYN_EVIDENCE_STORE_PATH=./data/evidence-store.json

# Optional Groq evaluator proposal layer. When configured, Groq proposes a
# structured decision behind the deterministic policy and schema gates.
# Provider errors fail closed with no settlement signature.
RESVYN_GROQ_KEY=
RESVYN_GROQ_MODEL=openai/gpt-oss-120b
RESVYN_GROQ_TIMEOUT_MS=30000

# Evaluate API rate limiting (process-local; use shared infrastructure before
# horizontally scaling the evaluator service).
RESVYN_RATE_LIMIT_MAX=10
RESVYN_RATE_LIMIT_WINDOW_MS=60000

# Trust forwarded client IP headers only behind a known proxy.
RESVYN_TRUST_PROXY=0

# Scripts-only secrets/configuration (deploy/rehearse/paymaster), not read by
# the browser. Keep these outside source control:
# RESVYN_DEPLOYER_KEY=
# RESVYN_CLAIMANT_KEY=
# RESVYN_PAYMASTER_URL=

# Archived full-lifecycle proof instance, retained only for reference:
# 0x414592d2313d233b673b1f97803c261355ccd996
